<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore from nuget.org only. Without <clear />, restore also queries every feed in the
  machine's own NuGet configuration (a company feed, for instance): the names of this
  repository's packages leak to it, and a package there with the same name and a higher
  version could be picked instead of the nuget.org one.
  The test project copies this file next to the end-to-end fixtures, which are restored
  from a temp directory this file would not otherwise reach.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
